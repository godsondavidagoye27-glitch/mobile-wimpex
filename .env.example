# Expo app configuration. EXPO_PUBLIC_* values are bundled into the client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-google-ios-client-id
EXPO_PUBLIC_OTP_LENGTH=6
EAS_BUILD_PROFILE=development

# Supabase Edge Function environment. Configure these with `supabase secrets set`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
WIMPEX_SERVICE_ROLE_KEY=your-wimpex-service-role-key

# LiveKit server-side credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Scheduled jobs and authenticated webhooks.
STORY_PURGE_SECRET=replace-with-a-long-random-secret
PUSH_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-long-random-secret
DEMO_REPLY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# AI captions Edge Function settings.
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
CAPTIONS_WEBHOOK_SECRET=replace-with-a-long-random-secret
AI_ENABLED=false
AI_CAPTIONS_ENABLED=false
AI_CAPTIONS_GLOBAL_DAILY_CAP=100

# Keep demo mode disabled except in a dedicated development environment.
DEMO_MODE=false

# Optional local seed setup only. Use a dedicated development Supabase project.
# The seed scripts read .env.seed, not this file.
SEED_ALLOWED=false
DEMO_PASSWORD=replace-with-a-strong-development-only-password
